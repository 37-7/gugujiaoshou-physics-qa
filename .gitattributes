# 统一换行符为 LF（避免 Windows CRLF 污染）
* text=auto
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
LICENSE text eol=lf

# 二进制文件不做换行转换
*.woff binary
*.woff2 binary
*.jpg binary
*.gif binary
*.png binary
